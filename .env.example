# Copy to .env.local for local work. On Vercel/Netlify, add these in the project's Environment Variables.
# Without the Supabase values the site runs in "demo mode" with sample stories, and nothing is saved.

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password for /admin, where you approve stories and prayer requests. Make it long.
ADMIN_PASSWORD=

# The public address of the site, used in share links and previews (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown on the About page under "Contact". Leave empty to hide.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
